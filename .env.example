# --- OpenSea (wajib untuk allowlist mint) ---
# Buat gratis di https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# --- 4 wallet whitelist, private key dipisah koma ---
# JANGAN share file ini ke siapa pun. chmod 600 .env
PRIVATE_KEYS=0x...,0x...,0x...,0x...

# --- Notifikasi Telegram (opsional, biar update mint masuk Telegram) ---
# 1. Chat @BotFather di Telegram -> /newbot -> ikuti langkahnya -> dapat token
# 2. Chat @userinfobot -> dapat chat ID kamu (angka)
# 3. Chat bot barumu sekali (tap Start) biar dia boleh kirim pesan ke kamu
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# TG_QUIET=true -> bot diam kecuali hal kritis (minta persetujuan). false -> kirim semua update.
# TG_QUIET=true

# --- Aturan main ---
# GRATIS (value=0) -> auto-mint. BERBAYAR -> wajib persetujuan user dulu.
# Jangan set true kecuali user sudah setuju secara eksplisit.
AUTO_MINT_PAID=false
RPC_URL=https://rpc.mainnet.chain.robinhood.com
DROP_SLUG=aerent
QUANTITY=1
POLL_MS=5000
MAX_WAIT_MINUTES=120
